{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/18534516725/Agent-Doctor/blob/main/schemas/nexotoken-usage-v1.schema.json",
  "title": "NexoToken user-scoped usage export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publicModelName", "inputTokens", "outputTokens", "cachedTokens", "chargedAmountMicros", "currency", "requestTimestamp"],
        "properties": {
          "publicModelName": { "type": "string", "minLength": 1 },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "cachedTokens": { "type": "integer", "minimum": 0 },
          "chargedAmountMicros": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "requestTimestamp": { "type": "string", "format": "date-time" },
          "taskCorrelationId": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}
